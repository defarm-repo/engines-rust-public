# Add these variables to your existing .env file for DFID Service integration

# DFID Service URL (optional)
# When set, the API will use remote DFID generation instead of local
# Leave commented for local DFID generation (backward compatible)
# DFID_SERVICE_URL=http://localhost:3001

# For production/Railway deployment:
# DFID_SERVICE_URL=https://defarm-dfid-service.up.railway.app

# Index Service URL (optional - future implementation)
# INDEX_SERVICE_URL=http://localhost:3002
